; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go in here are also accessible from the SCRIPT tab.

config_version=5

[application]

config/name="NEXUS 무술 창조"
config/description="세련된 빌드/무술 창조 게임 — 무술을 자유롭게 만들고 세상을 정복한다"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/dpi/allow_hidpi=true

[physics]

3d/default_gravity=9.8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
